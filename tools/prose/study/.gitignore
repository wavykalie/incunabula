# Generated by fixtures/make-fixtures.py and analysis/analyze.py. Regenerable from
# committed code, and the fixture books are synthetic text that nobody should mistake
# for data. The frozen premises ARE committed: they are the artifact.
fixtures/out/
analysis/out/
# run/out holds RUNPLAN.csv, per-book dispatch cards and payloads: derived from the frozen
# premises, and a rewritten plan must never look like a record of what was sent.
run/out/
__pycache__/

# C-dist: the catalog is 21MB and the texts are public domain but design §5 says they are
# stored for analysis and never redistributed. The committed artifact is corpus/
# dist-source.tsv plus dist-fetch-log.tsv (ids, strata, word counts, hashes) - reproducible
# from a re-run, and not a redistribution of anyone's prose.
corpus/pg_catalog.csv
books/C-*/

# The per-book extractor JSON is regenerable from a fetch; the baseline table derived from
# them is the artifact worth filing, so it stays.
corpus/dist-features/*.json
